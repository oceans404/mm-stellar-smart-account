# Shared service Stellar key — used by /api/sign-and-submit to sign tx envelopes.
# Never exposed to the browser. Friendbot-fund a fresh testnet Keypair, paste the
# secret here. Public address shows up at /api/service-info as a sanity check.
USDC_MM_SERVICE_SECRET=S...

# OpenZeppelin Channels API key — used by /api/sign-and-submit and /api/channels
# to relay txs. Get one at channels.openzeppelin.com.
CHANNELS_API_KEY=...
